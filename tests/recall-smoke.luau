-- Run through tools/test-recall.py against RecallLogic.

assert(RecallLogic.breaksChannel("move") == true)
assert(RecallLogic.breaksChannel("attack") == true)
assert(RecallLogic.breaksChannel("attackMove") == true)
assert(RecallLogic.breaksChannel("ability") == true)
assert(RecallLogic.breaksChannel("stop") == true)
assert(RecallLogic.breaksChannel("ward") == true)
assert(RecallLogic.breaksChannel("control") == true)
assert(RecallLogic.breaksChannel("lens") == true)
assert(RecallLogic.breaksChannel("cleave") == true)
assert(RecallLogic.breaksChannel("damage") == true)

assert(RecallLogic.breaksChannel("camera") == false)
assert(RecallLogic.breaksChannel("help") == false)
assert(RecallLogic.breaksChannel("emote") == false)
assert(RecallLogic.breaksChannel("ping") == false)
assert(RecallLogic.breaksChannel("shop") == false)
assert(RecallLogic.breaksChannel("ui") == false)
assert(RecallLogic.breaksChannel("") == false)

-- Fresh press cancels. A direction already held when the channel started does not,
-- until that input returns to rest and moves again.
assert(RecallLogic.isNewMoveOrder(false, true, false) == true)
assert(RecallLogic.isNewMoveOrder(false, false, false) == false)
assert(RecallLogic.isNewMoveOrder(true, true, false) == false)
assert(RecallLogic.isNewMoveOrder(true, false, false) == false)
assert(RecallLogic.isNewMoveOrder(true, true, true) == true)
assert(RecallLogic.isNewMoveOrder(true, false, true) == false)

assert(RecallLogic.movedTooFar(2.5, 2.5) == false)
assert(RecallLogic.movedTooFar(2.51, 2.5) == true)
assert(RecallLogic.movedTooFar(0, 2.5) == false)

-- Juice only reads the channel. It does not pick the 7s length or the cancel rules.
assert(RecallJuice.modeAllows("Moba", "InProgress") == true)
assert(RecallJuice.modeAllows("Hub", "InProgress") == false)
assert(RecallJuice.modeAllows("YarnRun", "InProgress") == false)
assert(RecallJuice.modeAllows("KoiPond", "InProgress") == false)
assert(RecallJuice.modeAllows("YarnParty", "InProgress") == false)
assert(RecallJuice.modeAllows("MemeArcade", "InProgress") == false)
assert(RecallJuice.modeAllows("Moba", "Lobby") == false)
assert(RecallJuice.modeAllows("Moba", "Ended") == false)
assert(RecallJuice.modeAllows("Moba", nil) == false)

assert(RecallJuice.progress(10, 17, 10) == 0)
assert(math.abs(RecallJuice.progress(10, 17, 13.5) - 0.5) < 0.001)
assert(RecallJuice.progress(10, 17, 17) == 1)
assert(RecallJuice.progress(10, 17, 20) == 1)
assert(RecallJuice.progress(10, 10, 12) == 0)
assert(RecallJuice.progress(nil, 17, 10) == 0)
-- Same ratio for any server window. Fallback 7 is display-only.
assert(RecallJuice.progress(0, 7, 7) == 1)
assert(RecallJuice.progress(0, 9, 9) == 1)
assert(RecallJuice.ChannelFallback == 7)

assert(RecallJuice.stateOutcome(false, true, 17, 10) == "channel")
assert(RecallJuice.stateOutcome(true, false, 17, 12) == "cancel")
assert(RecallJuice.stateOutcome(true, false, 17, 16.5) == "cancel")
assert(RecallJuice.stateOutcome(true, false, 17, 16.8) == "success")
assert(RecallJuice.stateOutcome(true, false, 17, 17) == "success")
assert(RecallJuice.stateOutcome(false, false, nil, 0) == "idle")
assert(RecallJuice.stateOutcome(true, false, nil, 17) == "cancel")

assert(RecallJuice.fxOutcome(7, 0, 0, 0) == "channel")
assert(RecallJuice.fxOutcome(0, 0, 0, 0) == "cancel")
assert(RecallJuice.originIsCancel(0, 0, 0) == true)
assert(RecallJuice.fxOutcome(0, -176, 1.4, 0) == "success")
assert(RecallJuice.fxOutcome(0, 176, 1.4, 0) == "success")
assert(RecallJuice.originIsCancel(-176, 1.4, 0) == false)
assert(RecallJuice.originIsCancel(0, 1.4, 0) == false)

assert(RecallJuice.cueKind(1, 1, true, false) == "local")
assert(RecallJuice.cueKind(1, 2, true, false) == "ally")
assert(RecallJuice.cueKind(1, 2, false, true) == "enemy")
assert(RecallJuice.cueKind(1, 2, false, false) == "none")
assert(RecallJuice.shouldPaint("local") == true)
assert(RecallJuice.shouldPaint("ally") == true)
assert(RecallJuice.shouldPaint("enemy") == true)
assert(RecallJuice.shouldPaint("none") == false)
assert(RecallJuice.shouldReveal("local", false) == true)
assert(RecallJuice.shouldReveal("ally", false) == true)
assert(RecallJuice.shouldReveal("enemy", true) == true)
assert(RecallJuice.shouldReveal("enemy", false) == false)
assert(RecallJuice.shouldReveal("none", true) == false)

local early = RecallJuice.fillSpan("local", 0)
local late = RecallJuice.fillSpan("local", 1)
assert(late > early)
assert(RecallJuice.trackSpan("local") >= late)
assert(RecallJuice.fillSpan("ally", 1) < RecallJuice.fillSpan("local", 1))
assert(RecallJuice.fillTransparency("local", 1) < RecallJuice.fillTransparency("local", 0))
assert(RecallJuice.fillTransparency("local", 1) < RecallJuice.trackTransparency("ally"))
assert(RecallJuice.cancelBanner() == "RECALL CANCELED")
assert(RecallJuice.tickDue(0, 0.2) == false)
assert(RecallJuice.tickDue(0, RecallJuice.TickGap) == true)
assert(RecallJuice.crossedWash(0.2, 0.5) == true)
assert(RecallJuice.crossedWash(0.5, 0.7) == false)
assert(RecallJuice.crossedWash(0.6, 0.9) == false)

print("PASS: recall cancels on new orders, not camera/shop/emote, and not a held move; recall juice paints channel progress, success, and cancel")
