-- Canal Levi. One river epic: wake, one respawn, team buff that does not stack, fog vs pit.
assert(RiverEpic.Id == "CanalLevi")
assert(RiverEpic.Name == "Canal Levi")
assert(RiverEpic.SpawnSeconds == 180)
assert(RiverEpic.RespawnSeconds == 90)
assert(RiverEpic.Lives == 2)
assert(RiverEpic.Health >= 1000)
assert(RiverEpic.X == 0 and RiverEpic.Z == 24)
assert(RiverEpic.DamageAmp == 1.08)
assert(RiverEpic.BuffChip == "Canal Levi · +8% damage")

local clock = RiverEpic.blank()
local earlyClock, earlySpawn = RiverEpic.step(clock, 179, false)
assert(earlySpawn == false and earlyClock.phase == "waiting")
local woke, doSpawn = RiverEpic.step(clock, 180, false)
assert(doSpawn == true and woke.phase == "alive" and woke.spawnsUsed == 1)
local held, heldSpawn = RiverEpic.step(woke, 200, true)
assert(heldSpawn == false and held.phase == "alive" and held == woke)
local returning = RiverEpic.killed(woke, 200)
assert(returning.phase == "returning" and returning.respawnAt == 290 and returning.spawnsUsed == 1)
local stillDown, notYet = RiverEpic.step(returning, 289, false)
assert(notYet == false and stillDown.phase == "returning")
local second, secondSpawn = RiverEpic.step(returning, 290, false)
assert(secondSpawn == true and second.phase == "alive" and second.spawnsUsed == 2)
local spent = RiverEpic.killed(second, 300)
assert(spent.phase == "spent" and spent.respawnAt == nil)
local done, doneSpawn = RiverEpic.step(spent, 999, false)
assert(doneSpawn == false and done.phase == "spent")
local ignored = RiverEpic.killed(spent, 999)
assert(ignored.phase == "spent")

local blueOnlyA, redOnlyA = RiverEpic.grant(false, false, "Blue")
assert(blueOnlyA == true and redOnlyA == false)
local blueOnlyB, redOnlyB = RiverEpic.grant(blueOnlyA, redOnlyA, "Blue")
assert(blueOnlyB == true and redOnlyB == false, "a second take does not stack")
local bothBlue, bothRed = RiverEpic.grant(blueOnlyB, redOnlyB, "Red")
assert(bothBlue == true and bothRed == true, "the other team can earn the buff on the return")
local strayBlue, strayRed = RiverEpic.grant(false, false, "Spectator")
assert(strayBlue == false and strayRed == false)

assert(RiverEpic.outgoingMul(false) == 1)
assert(RiverEpic.outgoingMul(true) == 1.08)
assert(RiverEpic.scale(24, false) == 24)
assert(math.abs(RiverEpic.scale(24, true) - 25.92) < 0.001)
