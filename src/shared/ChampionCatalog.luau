--!strict

local Types = require(script.Parent.Types)

local function ability(
	slot: Types.AbilitySlot,
	name: string,
	description: string,
	kind: Types.AbilityKind,
	stats: {
		cooldown: number,
		manaCost: number,
		range: number,
		radius: number,
		damage: number,
		heal: number,
		shield: number?,
		stunSeconds: number?,
		targeting: Types.AbilityTargeting?,
	}
): Types.AbilityDef
	return {
		slot = slot,
		name = name,
		description = description,
		kind = kind,
		cooldown = stats.cooldown,
		manaCost = stats.manaCost,
		range = stats.range,
		radius = stats.radius,
		damage = stats.damage,
		heal = stats.heal,
		shield = stats.shield or 0,
		stunSeconds = stats.stunSeconds or 0,
		targeting = stats.targeting,
	}
end

