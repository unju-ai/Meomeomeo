# Copy to .env locally. Never commit real values.
# Shared with Roblox Config.Nft404.ClaimApiSecret — NOT a chain key.
CLAIM_API_SECRET=

# Production: real HTTPS host players see. Do not ship meo404.local live.
SIWE_DOMAIN=meo404.local
SIWE_URI=https://meo404.local/siwe
SIWE_CHAIN_ID=1

# Studio / mock only. Unset before live Robux claims.
SIWE_ALLOW_UNVERIFIED=

# Lives only on this host — never in Roblox, Rojo, or Config.luau
# MEO404_MINTER_PRIVATE_KEY=
