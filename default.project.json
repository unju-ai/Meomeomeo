{
  "name": "MeoMeoMeo",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "CameraMaxZoomDistance": 48,
        "CameraMinZoomDistance": 8,
        "EnableMouseLockOption": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$ignoreUnknownInstances": true
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true
    },

    "Teams": {
      "$className": "Teams",
      "BlueWhiskers": {
        "$className": "Team",
        "$properties": {
          "AutoAssignable": false,
          "TeamColor": { "BrickColor": 23 }
        }
      },
      "RedPaws": {
        "$className": "Team",
        "$properties": {
          "AutoAssignable": false,
          "TeamColor": { "BrickColor": 21 }
        }
      }
    },

    "VoiceChatService": {
      "$className": "VoiceChatService",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "EnableDefaultVoice": true,
        "UseAudioApi": "Enabled"
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$ignoreUnknownInstances": true
    },

    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ClockTime": 21.15,
        "Brightness": 1.4,
        "Ambient": [0.204, 0.165, 0.267],
        "OutdoorAmbient": [0.306, 0.243, 0.376],
        "GeographicLatitude": 28,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.35,
        "EnvironmentSpecularScale": 0.22,
        "FogColor": [0.141, 0.110, 0.204],
        "FogStart": 90,
        "FogEnd": 460
      },
      "MeoAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.32,
          "Offset": 0.18,
          "Color": [0.463, 0.376, 0.580],
          "Decay": [0.361, 0.227, 0.188],
          "Glare": 0.12,
          "Haze": 1.35
        }
      },
      "MeoColor": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.08,
          "Saturation": 0.12,
          "TintColor": [1, 0.925, 0.863]
        }
      },
      "MeoBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.28,
          "Size": 12,
          "Threshold": 0.85
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "Gravity": 196.2
      }
    }
  }
}
